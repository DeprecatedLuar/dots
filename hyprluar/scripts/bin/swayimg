#!/usr/bin/env bash
# swayimg-shadow: opt-in wrapper around swayimg.
#   swayimg-shadow --wrap [swayimg args...]  open with window sized to the image ratio, clamped to MIN/MAX
#   swayimg-shadow [swayimg args...]         plain passthrough to the real swayimg
set -euo pipefail

readonly WRAP_FLAG="--wrap"
readonly REAL_BIN="swayimg"
readonly MIN_W=800
readonly MIN_H=600
readonly MAX_W=1600
readonly MAX_H=1000

# first argument that is an existing regular file
first_image() {
    local arg
    for arg in "$@"; do
        [[ -f $arg ]] && { printf '%s\n' "$arg"; return 0; }
    done
    return 1
}

# image_size FILE -> "W H" of the first frame
image_size() {
    identify -format '%w %h\n' "$1[0]"
}

# scaled_size W H -> "W,H": keep ratio, scale up to MIN, then cap at MAX (MAX wins on conflict)
scaled_size() {
    awk -v w="$1" -v h="$2" -v minw="$MIN_W" -v minh="$MIN_H" -v maxw="$MAX_W" -v maxh="$MAX_H" '
        function max(a, b) { return a > b ? a : b }
        function min(a, b) { return a < b ? a : b }
        BEGIN {
            s = 1
            if (w < minw || h < minh) s = max(minw / w, minh / h)
            if (w * s > maxw || h * s > maxh) s = min(maxw / w, maxh / h)
            printf "%d,%d\n", w * s + 0.5, h * s + 0.5
        }'
}

main() {
    local wrap=0 args=() arg
    for arg in "$@"; do
        if [[ $arg == "$WRAP_FLAG" ]]; then
            wrap=1
        else
            args+=("$arg")
        fi
    done
    set -- "${args[@]}"

    if (( ! wrap )); then
        exec "$REAL_BIN" "$@"
    fi

    local image dims size
    if ! image=$(first_image "$@"); then
        echo "swayimg-shadow: no image file in arguments, launching unmodified" >&2
        exec "$REAL_BIN" "$@"
    fi
    if ! dims=$(image_size "$image"); then
        echo "swayimg-shadow: could not read size of '$image', launching unmodified" >&2
        exec "$REAL_BIN" "$@"
    fi

    # shellcheck disable=SC2086  # dims is "W H", split intentionally
    size=$(scaled_size $dims)
    exec "$REAL_BIN" --size="$size" "$@"
}

main "$@"
