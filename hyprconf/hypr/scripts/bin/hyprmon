#!/usr/bin/env bash
# hyprmon — human-friendly hyprland monitor manager
#
# monitors.json is the source of truth; monitors.conf is generated from it and
# sourced by hyprland.conf. A reload discards every rule pushed via `hyprctl
# keyword monitor`, so without that sourced .conf Hyprland falls back to its own
# defaults and the layout drifts. Both live in $XDG_DATA_HOME/hypr: machine-
# specific, so they stay out of the dotfiles repo.
#
# Commands still push to the compositor with `hyprctl keyword monitor` so they
# take effect immediately rather than waiting on a reload.

set -euo pipefail

# Machine-specific state: XDG data dir, so it never reaches the dotfiles repo.
STATE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/hypr"
STATE_FILE="${STATE_DIR}/monitors.json"
STATE_CONF="${STATE_DIR}/monitors.conf"
CONF_HEADER="# Generated by hyprmon from monitors.json - do not edit."

HYPRLAND_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.conf"

DEFAULT_RESOLUTION="preferred"
DEFAULT_SCALE="1.0"
DEFAULT_POSITION="auto"
CENTER_POSITION="0x0"
# Blank columns between the longest monitor name and the "(info)" column.
INFO_COLUMN_GAP=2
# Time for the DRM output to actually go down before it is brought back up.
REDRAW_SETTLE_SECONDS="0.3"

RESET=""
BOLD=""
DIM=""
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    RESET="\033[0m"
    BOLD="\033[1m"
    DIM="\033[2m"
fi

# ==============================================================================
# ADAPTERS (PORTS / DRIVERS)
# ==============================================================================

# Hyprland reports .mirrorOf as a monitor *id* (e.g. "0"); resolve it to a name
# here so nothing downstream has to know about ids.
hypr_get_monitors() {
    local raw
    raw=$(hyprctl -j monitors all 2>/dev/null) || raw="[]"
    jq '
        (reduce .[] as $m ({}; .[$m.id | tostring] = $m.name)) as $by_id |
        map(.mirrorOf = (
            (.mirrorOf // "none") as $ref |
            if $ref == "none" then "none" else ($by_id[$ref] // $ref) end
        ))
    ' <<< "$raw" 2>/dev/null || echo "[]"
}

# Applies every rule in one IPC round-trip so the compositor reconfigures once.
hypr_apply_rules() {
    local rules=("$@")
    [[ ${#rules[@]} -eq 0 ]] && return 0

    local batch=""
    local rule
    for rule in "${rules[@]}"; do
        batch+="keyword monitor ${rule} ; "
    done

    if ! hyprctl --batch "${batch% ; }" >/dev/null; then
        echo "hyprmon: failed to apply monitor rules" >&2
        return 1
    fi
}

drm_get_port_status() {
    local port="$1"
    local p status
    for p in /sys/class/drm/card*-"${port}"; do
        if [[ -f "${p}/status" ]]; then
            read -r status < "${p}/status"
            echo "$status"
            return 0
        fi
    done
    echo "disconnected"
}

drm_list_all_ports() {
    local ports=()
    local p base
    for p in /sys/class/drm/card*-*; do
        [[ -f "${p}/status" ]] || continue
        base="${p##*/}"          # card1-DP-1
        ports+=("${base#*-}")    # DP-1
    done
    [[ ${#ports[@]} -eq 0 ]] && return 0
    printf "%s\n" "${ports[@]}" | sort -u
}

# An empty object is a valid state file: store_read's backfill is the single
# definition of the schema, so it does not need to be spelled out twice.
store_ensure_initialized() {
    [[ -f "$STATE_FILE" ]] && return 0
    mkdir -p "$STATE_DIR"
    echo '{}' > "$STATE_FILE"
}

store_read() {
    store_ensure_initialized
    # The schema. Also backfills keys added after a state file was first written.
    # .applied was a cache of the last pushed rules; app_sync no longer diffs
    # against anything, so it is dropped from any state file that still has it.
    jq '
        .aliases     //= {} |
        .slots       //= {} |
        .mirrors     //= {} |
        .disabled    //= {} |
        .resolutions //= {} |
        .scales      //= {} |
        del(.applied)
    ' "$STATE_FILE"
}

store_write() {
    local json="$1"
    store_ensure_initialized

    local tmp
    tmp="$(mktemp "${STATE_FILE}.XXXXXX")"
    if ! jq "." <<< "$json" > "$tmp"; then
        rm -f "$tmp"
        echo "hyprmon: refusing to write invalid state" >&2
        return 1
    fi
    mv -f "$tmp" "$STATE_FILE"
}

store_write_conf() {
    local body="$1"
    mkdir -p "$STATE_DIR"

    local tmp
    tmp="$(mktemp "${STATE_CONF}.XXXXXX")"
    {
        printf '%s\n\n' "$CONF_HEADER"
        [[ -n "$body" ]] && printf '%s\n' "$body"
    } > "$tmp"
    mv -f "$tmp" "$STATE_CONF"
}

# Reads hyprland.conf rather than trusting it, because a missing source line is
# silent until the next reload wipes the layout.
config_sources_conf() {
    [[ -f "$HYPRLAND_CONF" ]] || return 1

    local line path
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*source[[:space:]]*=[[:space:]]*(.+)$ ]] || continue
        path="${BASH_REMATCH[1]}"
        path="${path%"${path##*[![:space:]]}"}"
        path="${path/#\~/$HOME}"
        if [[ "$path" == "$STATE_CONF" ]]; then
            return 0
        fi
    done < "$HYPRLAND_CONF"

    return 1
}

# ==============================================================================
# DOMAIN (BUSINESS LOGIC)
# ==============================================================================

domain_normalize_direction() {
    case "${1,,}" in
        left|west|l|w)          echo "left" ;;
        right|east|r|e)         echo "right" ;;
        up|top|north|u|n)       echo "up" ;;
        down|bottom|south|d|s)  echo "down" ;;
        center)                 echo "center" ;;
        *)                      echo "unknown" ;;
    esac
}

domain_default_center() {
    local live_monitors="$1"
    jq -r 'map(select(.name | startswith("eDP"))) + . | .[0].name // "eDP-1"' <<< "$live_monitors"
}

# Resolves a user-supplied name to a canonical port. Returns 1 when nothing
# matches, so a typo can never be written into the state file as a "port".
domain_resolve_canonical_name() {
    local query="$1" state="$2"

    local aliased
    aliased=$(jq -r --arg q "$query" '.aliases[$q] // empty' <<< "$state")
    if [[ -n "$aliased" ]]; then
        echo "$aliased"
        return 0
    fi

    local port
    while IFS= read -r port; do
        if [[ "${port,,}" == "${query,,}" ]]; then
            echo "$port"
            return 0
        fi
    done < <(drm_list_all_ports)

    local dir
    dir=$(domain_normalize_direction "$query")
    if [[ "$dir" != "unknown" ]]; then
        local slotted
        slotted=$(jq -r --arg d "$dir" '.slots[$d] // empty' <<< "$state")
        if [[ -n "$slotted" ]]; then
            echo "$slotted"
            return 0
        fi
    fi

    return 1
}

domain_validate_scale() {
    [[ "$1" == "auto" || "$1" =~ ^[0-9]+(\.[0-9]+)?$ ]]
}

domain_validate_resolution() {
    [[ "$1" == "preferred" || "$1" == "highres" || "$1" == "highrr" \
       || "$1" =~ ^[0-9]+x[0-9]+(@[0-9]+(\.[0-9]+)?)?$ ]]
}

domain_get_display_name() {
    local port="$1" state="$2"
    jq -r --arg p "$port" 'first(.aliases | to_entries[] | select(.value == $p) | .key) // $p' <<< "$state"
}

# Every live monitor that is not the center.
domain_external_monitors() {
    local state="$1" live_monitors="$2"

    local center
    center=$(jq -r '.slots.center // empty' <<< "$state")
    jq -r --arg c "$center" '.[] | select(.name != $c) | .name' <<< "$live_monitors"
}

# Hands a monitor back to Hyprland's own runtime defaults.
domain_default_rule() {
    echo "$1,${DEFAULT_RESOLUTION},${DEFAULT_POSITION},${DEFAULT_SCALE}"
}

# Every rule hyprmon owns, as "port<TAB>rule". A port absent from this list is
# not managed and is left untouched by the compositor push, so this is both the
# rule generator and the definition of the managed set.
domain_desired_rules() {
    jq -r --arg res "$DEFAULT_RESOLUTION" \
          --arg scale "$DEFAULT_SCALE" \
          --arg center_pos "$CENTER_POSITION" '
        . as $st |
        [ (.slots    | to_entries[] | select(.value != null) | .value),
          (.mirrors  | keys[]),
          (.disabled | to_entries[] | select(.value) | .key)
        ] | unique[] as $p |

        ($st.resolutions[$p] // $res)   as $r |
        ($st.scales[$p]      // $scale) as $s |
        (
            if ($st.disabled[$p] // false) then
                "\($p),disable"
            elif ($st.mirrors[$p] // null) != null then
                "\($p),\($r),auto,\($s),mirror,\($st.mirrors[$p])"
            elif $st.slots.center == $p then
                "\($p),\($r),\($center_pos),\($s)"
            else
                (first($st.slots | to_entries[] | select(.value == $p and .key != "center") | .key) // "") as $slot |
                if $slot == "" then "" else "\($p),\($r),auto-\($slot),\($s)" end
            end
        ) as $rule |
        select($rule != "") | [$p, $rule] | @tsv
    ' <<< "$1"
}

# The rule for one port. Empty means "not managed".
domain_desired_rule() {
    domain_desired_rules "$1" | awk -F'\t' -v port="$2" '$1 == port { print $2 }'
}

# The body of the generated .conf, from "port<TAB>rule" pairs. The center goes
# first: every other rule positions itself with auto-<dir>, which resolves
# against the monitors already placed above it.
domain_conf_body() {
    local center="$1"
    shift

    local pair port rule
    for pair in "$@"; do
        IFS=$'\t' read -r port rule <<< "$pair"
        if [[ "$port" == "$center" ]]; then
            echo "monitor=${rule}"
        fi
    done
    for pair in "$@"; do
        IFS=$'\t' read -r port rule <<< "$pair"
        if [[ "$port" != "$center" ]]; then
            echo "monitor=${rule}"
        fi
    done
}

# ==============================================================================
# APPLICATION (USE CASES)
# ==============================================================================

# The only resolver callers should use: turns a resolution failure into a
# message plus a nonzero exit instead of a silently invented port name.
app_resolve() {
    local query="$1" state="$2" resolved
    if ! resolved=$(domain_resolve_canonical_name "$query" "$state"); then
        if [[ "$(domain_normalize_direction "$query")" != "unknown" ]]; then
            echo "hyprmon: no monitor in slot '$query'" >&2
        else
            echo "hyprmon: no such monitor '$query'" >&2
        fi
        return 1
    fi
    echo "$resolved"
}

# Guard for commands that must produce a visible change now. Hyprland accepts a
# `keyword monitor` rule for a port with nothing plugged into it, so without this
# every such command reports success while nothing happens.
app_require_connected() {
    local port="$1" name="$2"
    if [[ "$(drm_get_port_status "$port")" != "connected" ]]; then
        echo "hyprmon: '$name' is not connected" >&2
        return 1
    fi
}

# Self-heal, run on every invocation: regenerates monitors.conf from the state
# file and pushes every rule hyprmon owns.
#
# Unconditionally, with no diff against a cache of what was pushed before. Such a
# cache is a claim about state hyprmon does not own: after a prolonged DPMS-off
# cycle or a hotplug, Hyprland re-adds the output at its own defaults, the cache
# still says "already applied", and the drift sticks. Re-pushing an unchanged
# rule is a no-op to the compositor, so pushing everything costs nothing and is
# always correct.
app_sync() {
    if ! config_sources_conf; then
        cat >&2 << EOF
hyprmon: hyprland.conf is missing the monitors.conf source line.
Add this near the other source lines:

  source = ${STATE_CONF/#$HOME/\~}

Without it, a config reload discards the layout.
EOF
        return 1
    fi

    local state
    state=$(store_read)

    local rules=() pairs=()
    local port desired
    while IFS=$'\t' read -r port desired; do
        pairs+=("${port}"$'\t'"${desired}")
        rules+=("$desired")
    done < <(domain_desired_rules "$state")

    hypr_apply_rules "${rules[@]}"

    # Regenerated on every sync: this is what survives the next config reload.
    store_write_conf "$(domain_conf_body "$(jq -r '.slots.center // empty' <<< "$state")" "${pairs[@]}")"
}

# Tears the output down and brings it back with its saved rule. For monitors
# that are configured correctly but drawing wrong (stale mode, black screen
# after a cable reconnect) — re-pushing an unchanged rule is a no-op to the
# compositor, so a real off/on cycle is the only thing that rebuilds the output.
app_redraw() {
    local target_query="$1"

    local state
    state=$(store_read)

    local target name
    target=$(app_resolve "$target_query" "$state") || return 1
    name=$(domain_get_display_name "$target" "$state")
    app_require_connected "$target" "$name" || return 1

    if [[ "$(jq -r --arg p "$target" '.disabled[$p] // false' <<< "$state")" == "true" ]]; then
        echo "hyprmon: '$name' is disabled; use 'hyprmon enable $name'" >&2
        return 1
    fi

    local rule
    rule=$(domain_desired_rule "$state" "$target")
    [[ -n "$rule" ]] || rule=$(domain_default_rule "$target")

    hypr_apply_rules "${target},disable"
    sleep "$REDRAW_SETTLE_SECONDS"
    hypr_apply_rules "$rule"
}

# Position only — never touches .mirrors. A monitor's slot is where it sits
# when extending; mirroring is an independent mode layered on top of it.
app_place() {
    local target_query="$1" raw_direction="$2"

    local dir
    dir=$(domain_normalize_direction "$raw_direction")
    if [[ "$dir" == "unknown" ]]; then
        echo "hyprmon: unknown direction '$raw_direction'" >&2
        return 1
    fi

    local state
    state=$(store_read)

    local target name
    target=$(app_resolve "$target_query" "$state") || return 1
    name=$(domain_get_display_name "$target" "$state")
    app_require_connected "$target" "$name" || return 1

    # Move the target into $dir. Whoever was in $dir (if anyone) falls back
    # into the slot the target vacated (if any) — empty destination is a
    # plain move, occupied destination is a swap, same transform either way.
    state=$(jq --arg t "$target" --arg dir "$dir" '
        .slots[$dir] as $occupant |
        (first(.slots | to_entries[] | select(.value == $t) | .key) // null) as $vacated |
        .slots[$dir] = $t |
        (if $vacated != null and $vacated != $dir then .slots[$vacated] = $occupant else . end) |
        del(.disabled[$t])
    ' <<< "$state")

    store_write "$state"
    app_sync
}

# Mode only — never touches .slots, so the monitor keeps its position for
# when it later extends again.
app_mirror() {
    local target_query="$1" src_query="${2:-}"

    local state live_monitors
    state=$(store_read)
    live_monitors=$(hypr_get_monitors)

    local target name center
    target=$(app_resolve "$target_query" "$state") || return 1
    name=$(domain_get_display_name "$target" "$state")
    app_require_connected "$target" "$name" || return 1
    center=$(jq -r '.slots.center // empty' <<< "$state")
    [[ -n "$center" ]] || center=$(domain_default_center "$live_monitors")

    local src src_name
    src="${src_query:-$center}"
    src=$(app_resolve "$src" "$state") || return 1
    src_name=$(domain_get_display_name "$src" "$state")
    app_require_connected "$src" "$src_name" || return 1

    if [[ "$src" == "$target" ]]; then
        echo "hyprmon: '$name' cannot mirror itself" >&2
        return 1
    fi

    state=$(jq --arg t "$target" --arg s "$src" '
        .mirrors[$t] = $s | del(.disabled[$t])
    ' <<< "$state")

    store_write "$state"
    app_sync
    app_redraw "$target"
}

# Drops mirror mode and returns the monitor to its saved slot.
app_extend() {
    local target_query="$1"

    local state
    state=$(store_read)

    local target name
    target=$(app_resolve "$target_query" "$state") || return 1
    name=$(domain_get_display_name "$target" "$state")
    app_require_connected "$target" "$name" || return 1

    if [[ "$(jq -r --arg t "$target" '.mirrors[$t] // empty' <<< "$state")" == "" ]]; then
        echo "hyprmon: '$name' is not mirroring" >&2
        return 1
    fi

    if [[ "$(jq -r --arg t "$target" \
          'first(.slots | to_entries[] | select(.value == $t) | .key) // empty' <<< "$state")" == "" ]]; then
        echo "hyprmon: no saved position for '$name'" >&2
        echo "use: hyprmon mv $name <left|right|up|down>" >&2
        return 1
    fi

    state=$(jq --arg t "$target" 'del(.mirrors[$t])' <<< "$state")
    store_write "$state"
    app_sync
    app_redraw "$target"
}

app_mv() {
    local target_query="$1" dest="$2"

    case "${dest,,}" in
        mirror|clone)
            echo "hyprmon: use 'hyprmon mirror $target_query' to mirror a monitor" >&2
            return 1
            ;;
    esac

    # Resolved to a port up front and reused throughout: target_query may be a
    # positional selector (e.g. "left"), and the move itself can change which
    # monitor that word refers to, so re-resolving it afterwards would be
    # querying stale state.
    local state target
    state=$(store_read)
    target=$(app_resolve "$target_query" "$state") || return 1

    local dir
    dir=$(domain_normalize_direction "$dest")
    if [[ "$dir" == "unknown" ]]; then
        # Destination names a monitor, not a direction: move the target into
        # whatever slot that monitor occupies (swapping the two).
        local dest_port
        dest_port=$(app_resolve "$dest" "$state") || return 1
        dir=$(jq -r --arg p "$dest_port" \
            'first(.slots | to_entries[] | select(.value == $p) | .key) // empty' <<< "$state")
        if [[ -z "$dir" ]]; then
            echo "hyprmon: '$dest' occupies no slot" >&2
            return 1
        fi
    fi

    app_place "$target" "$dir" || return 1

    # A mirroring monitor's desired rule is unchanged by a slot move, so an
    # off/on cycle here would just flicker the screen for nothing.
    local name mirror_src
    state=$(store_read)
    name=$(domain_get_display_name "$target" "$state")
    mirror_src=$(jq -r --arg t "$target" '.mirrors[$t] // empty' <<< "$state")

    if [[ -n "$mirror_src" ]]; then
        printf "saved: %s -> %s\n" "$name" "$dest"
        printf "%s is mirroring %s; run 'hyprmon extend %s' to apply\n" \
            "$name" "$(domain_get_display_name "$mirror_src" "$state")" "$name"
        return 0
    fi

    # Repositioning leaves the layer-shell surfaces bound to that output stale
    # (wallpaper goes black). Only an off/on cycle rebuilds them, so the move is
    # not finished until the output has been redrawn.
    app_redraw "$target"
    report_done
}

app_set_property() {
    local field="$1" target_query="$2" value="$3"

    local state
    state=$(store_read)

    local target
    target=$(app_resolve "$target_query" "$state") || return 1
    app_require_connected "$target" "$(domain_get_display_name "$target" "$state")" || return 1

    state=$(jq --arg f "$field" --arg t "$target" --arg v "$value" '.[$f][$t] = $v' <<< "$state")
    store_write "$state"
    app_sync
}

app_set_resolution() {
    if ! domain_validate_resolution "$2"; then
        echo "hyprmon: invalid resolution '$2' (expected WxH[@R], preferred, highres or highrr)" >&2
        return 1
    fi
    app_set_property "resolutions" "$1" "$2"
}

app_set_scale() {
    if ! domain_validate_scale "$2"; then
        echo "hyprmon: invalid scale '$2' (expected a number like 1.5, or auto)" >&2
        return 1
    fi
    app_set_property "scales" "$1" "$2"
}

# Drops every saved setting for a monitor — aliases included — and hands it back
# to Hyprland's own runtime defaults (preferred mode, auto position, scale 1).
app_forget() {
    local target_query="$1"

    local state
    state=$(store_read)

    local target name
    target=$(app_resolve "$target_query" "$state") || return 1
    name=$(domain_get_display_name "$target" "$state")

    local saved
    saved=$(jq -r --arg t "$target" '
        [ (.slots | to_entries[] | select(.value == $t)),
          (.aliases     | to_entries[] | select(.value == $t)),
          (.mirrors     | to_entries[] | select(.key == $t)),
          (.disabled    | to_entries[] | select(.key == $t)),
          (.resolutions | to_entries[] | select(.key == $t)),
          (.scales      | to_entries[] | select(.key == $t)) ] | length
    ' <<< "$state")

    if [[ "$saved" -eq 0 ]]; then
        echo "hyprmon: no saved entry for '$name'" >&2
        return 1
    fi

    state=$(jq --arg t "$target" '
        .slots   |= with_entries(if .value == $t then .value = null else . end) |
        .aliases |= with_entries(select(.value != $t)) |
        del(.mirrors[$t]) | del(.disabled[$t]) |
        del(.resolutions[$t]) | del(.scales[$t])
    ' <<< "$state")
    store_write "$state"

    hypr_apply_rules "$(domain_default_rule "$target")"
    app_sync

    printf -- "- %s  (reset to runtime defaults)\n" "$name"
}

app_toggle() {
    local target_query="$1" action="$2"

    local state
    state=$(store_read)

    local target
    target=$(app_resolve "$target_query" "$state") || return 1
    app_require_connected "$target" "$(domain_get_display_name "$target" "$state")" || return 1

    if [[ "$action" == "disable" ]]; then
        state=$(jq --arg t "$target" '.disabled[$t] = true' <<< "$state")
    else
        state=$(jq --arg t "$target" 'del(.disabled[$t])' <<< "$state")
    fi

    store_write "$state"
    app_sync

    local mark="+"
    [[ "$action" == "disable" ]] && mark="~"
    printf "%s %s  (%sd)\n" "$mark" "$(domain_get_display_name "$target" "$state")" "$action"
}

# Alias commands are pure metadata — they never touch the compositor.
app_alias() {
    local target_query="$1" alias_name="$2"

    local state target
    state=$(store_read)
    target=$(app_resolve "$target_query" "$state") || return 1

    store_write "$(jq --arg a "$alias_name" --arg t "$target" '.aliases[$a] = $t' <<< "$state")"
    printf "+ %s (%s)\n" "$alias_name" "$target"
}

app_rename() {
    local old_alias="$1" new_alias="$2" state
    state=$(store_read)

    local port
    port=$(jq -r --arg a "$old_alias" '.aliases[$a] // empty' <<< "$state")
    if [[ -z "$port" ]]; then
        echo "hyprmon: alias '$old_alias' not found" >&2
        return 1
    fi

    store_write "$(jq --arg old "$old_alias" --arg new "$new_alias" --arg p "$port" \
        'del(.aliases[$old]) | .aliases[$new] = $p' <<< "$state")"
    printf "~ %s -> %s\n" "$old_alias" "$new_alias"
}

# ==============================================================================
# VIEW
# ==============================================================================

# Layout commands (mv, mirror, redraw, res, scale) have no result
# worth restating — the monitors themselves are the feedback. Commands that
# change the saved set (enable/disable, alias, rm) print their own +/-/~ line.
report_done() {
    echo "done"
}

# What the terminal actually shows. The colour constants hold literal "\033[..m"
# (echo -e expands them at print time), so ${#s} would count those as text and
# printf's %-*s would pad by them — both misalign every coloured row.
view_visible_width() {
    local s="$1" esc
    for esc in "$BOLD" "$DIM" "$RESET"; do
        [[ -n "$esc" ]] && s="${s//"$esc"/}"
    done
    echo "${#s}"
}

# Prints "name<TAB>info" rows with every (info) starting at the same column.
# Needs the whole set up front, hence rows-in / lines-out rather than per-row
# printing: the column is only known once the longest name is.
view_align_rows() {
    local rows=("$@")
    local row name info width max=0

    for row in "${rows[@]}"; do
        width=$(view_visible_width "${row%%$'\t'*}")
        (( width > max )) && max=$width
    done

    for row in "${rows[@]}"; do
        name="${row%%$'\t'*}"
        info="${row#*$'\t'}"
        if [[ -z "$info" ]]; then
            printf '%b\n' "$name"
            continue
        fi
        width=$(view_visible_width "$name")
        printf '%b%*s%b(%s)%b\n' \
            "$name" "$(( max - width + INFO_COLUMN_GAP ))" "" "$DIM" "$info" "$RESET"
    done
}

# Builds one "name<TAB>info" row; view_align_rows owns the spacing.
view_render_monitor() {
    local port="$1" prefix="$2" state="$3" live_monitors="$4"

    local name center slot info
    name=$(domain_get_display_name "$port" "$state")
    center=$(jq -r '.slots.center // empty' <<< "$state")
    slot=$(jq -r --arg p "$port" 'first(.slots | to_entries[] | select(.value == $p) | .key) // empty' <<< "$state")

    local disabled
    disabled=$(jq -r --arg p "$port" \
        'first(.[] | select(.name == $p)) | .disabled // false' <<< "$live_monitors")

    local display_name="$name"
    [[ "$port" == "$center" ]] && display_name="${BOLD}${name}${RESET}"

    local mark="+"
    [[ "$disabled" == "true" ]] && mark="~"

    if [[ "$disabled" == "true" ]]; then
        info="disabled"
    else
        # Mirror source is already implied by the tree prefix (the "└─" under
        # its parent), so the slot alone is the useful thing to show here.
        info="$slot"
    fi

    printf '%s\t%s\n' "${prefix}${mark} ${display_name}" "$info"
}

# Full detail for one monitor: saved config alongside live runtime values.
app_get() {
    local target_query="$1"

    local state live_monitors
    state=$(store_read)
    live_monitors=$(hypr_get_monitors)

    local target name
    target=$(app_resolve "$target_query" "$state") || return 1
    name=$(domain_get_display_name "$target" "$state")

    local status
    status=$(drm_get_port_status "$target")

    local live
    live=$(jq -r --arg p "$target" 'first(.[] | select(.name == $p)) // empty' <<< "$live_monitors")

    local row_fmt="  ${DIM}%-14s${RESET} %s\n"

    echo -e "${BOLD}${name}${RESET} ${DIM}(${target})${RESET}"
    printf "$row_fmt" "status" "$status"

    local slot mirror_src
    slot=$(jq -r --arg p "$target" 'first(.slots | to_entries[] | select(.value == $p) | .key) // "unassigned"' <<< "$state")
    mirror_src=$(jq -r --arg p "$target" '.mirrors[$p] // empty' <<< "$state")

    printf "$row_fmt" "slot" "$slot"
    printf "$row_fmt" "mode" "$([[ -n "$mirror_src" ]] && echo mirror || echo extend)"
    [[ -n "$mirror_src" ]] && printf "$row_fmt" "mirrors" "$(domain_get_display_name "$mirror_src" "$state")"

    printf "$row_fmt" "saved res" "$(jq -r --arg p "$target" --arg d "$DEFAULT_RESOLUTION" '.resolutions[$p] // "\($d) (default)"' <<< "$state")"
    printf "$row_fmt" "saved scale" "$(jq -r --arg p "$target" --arg d "$DEFAULT_SCALE" '.scales[$p] // "\($d) (default)"' <<< "$state")"
    printf "$row_fmt" "saved rule" "$(domain_desired_rule "$state" "$target" | grep . || echo "(unmanaged)")"

    if [[ -z "$live" ]]; then
        printf "$row_fmt" "live" "(not present in compositor)"
        return 0
    fi

    local disabled width height rate scale pos_x pos_y mirror desc modes
    IFS=$'\t' read -r disabled width height rate scale pos_x pos_y mirror desc modes < <(jq -r '
        [ (.disabled // false | tostring),
          (.width | tostring), (.height | tostring),
          (.refreshRate // 0 | round | tostring),
          (.scale | tostring),
          (.x | tostring), (.y | tostring),
          (.mirrorOf // "none"),
          (.description // .model // "unknown"),
          ((.availableModes // []) | length | tostring) ] | @tsv
    ' <<< "$live")

    printf "$row_fmt" "live mode" "${width}x${height}@${rate}Hz"
    printf "$row_fmt" "live scale" "$scale"
    printf "$row_fmt" "position" "${pos_x}x${pos_y}"
    printf "$row_fmt" "enabled" "$([[ "$disabled" == "true" ]] && echo no || echo yes)"
    [[ "$mirror" != "none" ]] && printf "$row_fmt" "mirroring" "$(domain_get_display_name "$mirror" "$state")"
    printf "$row_fmt" "description" "$desc"
    printf "$row_fmt" "modes" "$modes available"
}

app_list() {
    local show_all="${1:-false}"

    local state live_monitors
    state=$(store_read)
    live_monitors=$(hypr_get_monitors)

    local ports=()
    if [[ "$show_all" == "true" ]]; then
        mapfile -t ports < <(drm_list_all_ports)
    else
        mapfile -t ports < <({
            jq -r '.[].name' <<< "$live_monitors"
            jq -r '.aliases | values[]' <<< "$state"
        } | sort -u)
    fi

    # Read the mirror topology once; the tree below is pure lookups.
    local -A mirror_of=()
    local name mirror
    while IFS=$'\t' read -r name mirror; do
        mirror_of["$name"]="$mirror"
    done < <(jq -r '.[] | [.name, (.mirrorOf // "none")] | @tsv' <<< "$live_monitors")

    local roots=() offline=() port status
    for port in "${ports[@]}"; do
        [[ -n "$port" ]] || continue
        status=$(drm_get_port_status "$port")
        if [[ "$status" != "connected" ]]; then
            offline+=("$port")
            continue
        fi
        [[ "${mirror_of[$port]:-none}" == "none" ]] && roots+=("$port")
    done

    local rows=() root children child i
    for root in "${roots[@]}"; do
        rows+=("$(view_render_monitor "$root" "" "$state" "$live_monitors")")

        children=()
        for port in "${ports[@]}"; do
            [[ "${mirror_of[$port]:-none}" == "$root" ]] && children+=("$port")
        done

        for i in "${!children[@]}"; do
            child="${children[$i]}"
            if (( i < ${#children[@]} - 1 )); then
                rows+=("$(view_render_monitor "$child" "${DIM}  ├─ ${RESET}" "$state" "$live_monitors")")
            else
                rows+=("$(view_render_monitor "$child" "${DIM}  └─ ${RESET}" "$state" "$live_monitors")")
            fi
        done
    done

    for port in "${offline[@]}"; do
        name=$(domain_get_display_name "$port" "$state")
        rows+=("${DIM}- ${name}${RESET}"$'\t')
    done

    [[ ${#rows[@]} -eq 0 ]] || view_align_rows "${rows[@]}"
}

show_help() {
    cat << 'EOF'
Usage:
  hyprmon                                 list monitors
  hyprmon ls|list [-a|--all]
  hyprmon get <name>                      full detail: saved config + live state
  hyprmon mv [name] <direction|other_monitor>
  hyprmon mirror [source] [destination]   destination becomes a mirror of source
  hyprmon extend|unmirror [name]          stop mirroring, return to its slot
  hyprmon enable|disable [name]
  hyprmon reload|redraw|restart [name]    off/on cycle to rebuild the output
  hyprmon res <name> <WxH[@R]>
  hyprmon scale|zoom <name> <factor>      scale is the per-monitor zoom
  hyprmon rm|remove <name>                forget saved config and alias
  hyprmon alias|add <port> <alias>
  hyprmon rename <old_alias> <new_alias>

Positions:
  left, right, up, down, center

A position also names whatever monitor is in that slot:
  hyprmon mv left right      move/swap the left monitor into the right slot
  hyprmon get center
EOF
}

# ==============================================================================
# CLI (ORCHESTRATION)
# ==============================================================================

resolve_optional_target() {
    local candidate="${1:-}"
    if [[ -n "$candidate" ]]; then
        echo "$candidate"
        return 0
    fi

    local state live_monitors externals=()
    state=$(store_read)
    live_monitors=$(hypr_get_monitors)
    mapfile -t externals < <(domain_external_monitors "$state" "$live_monitors")

    case ${#externals[@]} in
        1) echo "${externals[0]}" ;;
        0) echo "hyprmon: no external monitor detected" >&2; return 1 ;;
        *) echo "hyprmon: multiple external monitors connected; specify a name" >&2; return 1 ;;
    esac
}

main() {
    if [[ $# -eq 0 ]]; then
        app_sync
        app_list false
        return 0
    fi

    local action="$1"
    shift

    case "$action" in
        -h|--help|help)
            show_help
            ;;
        ls|list|status)
            local show_all=false
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -a|--all) show_all=true ;;
                    *) echo "hyprmon: unknown option '$1'" >&2; return 1 ;;
                esac
                shift
            done
            app_sync
            app_list "$show_all"
            ;;
        get|show|info)
            local target
            target=$(resolve_optional_target "${1:-}") || return 1
            app_sync
            app_get "$target"
            ;;
        # <source> <destination>: destination becomes a mirror of source.
        mirror|clone)
            local src="" dest
            case $# in
                0) dest=$(resolve_optional_target "") || return 1 ;;
                1) src="$1"; dest=$(resolve_optional_target "") || return 1 ;;
                2) src="$1"; dest="$2" ;;
                *) echo "Usage: hyprmon mirror [source] [destination]" >&2; return 1 ;;
            esac
            app_mirror "$dest" "$src"
            report_done
            ;;
        extend|unmirror)
            local target
            target=$(resolve_optional_target "${1:-}") || return 1
            app_extend "$target"
            report_done
            ;;
        reload|redraw|restart)
            local target
            target=$(resolve_optional_target "${1:-}") || return 1
            app_redraw "$target"
            report_done
            ;;
        enable|disable)
            local target
            target=$(resolve_optional_target "${1:-}") || return 1
            app_toggle "$target" "$action"
            ;;
        # One arg is the destination alone; the target is then the only external.
        # A destination that is a monitor rather than a direction swaps the two,
        # so this is also the swap command.
        mv|move)
            local target dest
            case $# in
                1) target=$(resolve_optional_target "") || return 1; dest="$1" ;;
                2) target="$1"; dest="$2" ;;
                *) echo "Usage: hyprmon mv [name] <direction|other_monitor>" >&2; return 1 ;;
            esac
            app_mv "$target" "$dest"
            ;;
        res|resolution)
            [[ $# -eq 2 ]] || { echo "Usage: hyprmon res <name> <WxH[@R]>" >&2; return 1; }
            app_set_resolution "$1" "$2"
            report_done
            ;;
        scale|zoom)
            [[ $# -eq 2 ]] || { echo "Usage: hyprmon $action <name> <factor>" >&2; return 1; }
            app_set_scale "$1" "$2"
            report_done
            ;;
        rm|remove|forget)
            [[ $# -eq 1 ]] || { echo "Usage: hyprmon rm <name>" >&2; return 1; }
            app_forget "$1"
            ;;
        alias|add)
            [[ $# -eq 2 ]] || { echo "Usage: hyprmon alias <port> <alias>" >&2; return 1; }
            app_alias "$1" "$2"
            ;;
        rename)
            [[ $# -eq 2 ]] || { echo "Usage: hyprmon rename <old_alias> <new_alias>" >&2; return 1; }
            app_rename "$1" "$2"
            ;;
        *)
            echo "hyprmon: unknown command '$action'" >&2
            show_help >&2
            return 1
            ;;
    esac
}

main "$@"
