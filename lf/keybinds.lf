# use enter for shell commands
map <enter> shell

# execute current file (must be executable)
map x $$f
map X !$f

###########################################################################
#                             Basic                                       #
###########################################################################

map Q quit
map q quit
map ZZ quit
map ZQ quit

map R reload
map <c-r> reload
map <c-l> redraw
map <c-c> cmd-interrupt
map <esc> cmd-escape

map ? doc
map S push :shell<enter>$SHELL<enter>

map \:  read
map \;  read
map \!  shell
map @   shell
map \#  shell-wait
map s   shell
map f find
map c
map cd push :read<enter>cd<space>

## Change the line mode
map Mf :set info
map Mm :set info time
map Mh :set info time
map Ms :set info size:time
map MH :set size:time

# Tagging / Marking
map <space> :toggle; down
map v       invert
map u
map uv      push :glob-select<space>*<enter>
map uu      trash-undo

# For the nostalgics: Midnight Commander bindings
map <f-1> doc
map <f-2> rename
map <f-4> open
map <f-5> copy
map <f-6> cut
map <f-7> push :mkdir<space>
map <f-8> push :delete<space>
map <f-10> quit

# Arrow keys
map <up>    up
map <down>  down
map <left>  updir
map <right> open
map <home>  top
map <end>   bottom
map <pgup>  page-up
map <pgdn>  page-down
map <cr>    open

map <insert> push :shell<enter>touch<space>

# VIM-stuff (fixed from original)
map h updir
map j down
map k up
map l open

# Jumping around
map ]  push hkl
map [  push hjl

map gh cd ~
map ge cd /etc
map gu cd /usr
map gd cd /dev
map go cd /opt
map gv cd /var
map gm cd /media
map gM cd /mnt
map gs cd /srv
map gp cd /tmp
map gr cd /
map gz push :z<space>
map g/ cd /

# External Programs
map E $$EDITOR "$f"
map d
map du push :shell-wait<enter>du<space>--max-depth=1<space>-h<space>--apparent-size<enter>
map dU push :shell-wait<enter>du<space>--max-depth=1<space>-h<space>--apparent-size<space>|sort<space>-rh<enter>

# Filesystem Operations
map cw push :rename<space>
map a  rename
map A  rename
map I  rename
map r  push :open-with<space>

map p
map pp paste

map dD push :trash
map dX push :delete

# <f-50> is a virtual key pushed by the trash prompt; the next key answers it
map <f-50>y trash-confirmed
map <f-50>n echomsg "trash cancelled"

map dd cut

map y
map yy copy

# Searching
map /  search
map n  search-next
map N  search-prev

# Sorting (note: multiline {{ }} required — inline breaks config parsing)
map or set reverse!
map os :{{
    set sortby size
    set noreverse
}}
map on :{{
    set sortby natural
    set noreverse
}}
map om :{{
    set sortby time
    set noreverse
}}
map oc :{{
    set sortby ctime
    set noreverse
}}
map oa :{{
    set sortby atime
    set noreverse
}}
map oe :{{
    set sortby ext
    set noreverse
}}
map oS :{{
    set sortby size
    set reverse
}}
map oN :{{
    set sortby natural
    set reverse
}}
map oM :{{
    set sortby time
    set reverse
}}
map oC :{{
    set sortby ctime
    set reverse
}}
map oA :{{
    set sortby atime
    set reverse
}}
map oE :{{
    set sortby ext
    set reverse
}}

# Settings
map zc :{{
    set preview!
}}
map zd    set dirfirst!
map zh    set hidden!
map <c-h> set hidden!
map <backspace>  set hidden!
map <backspace2> set hidden!
map zs    set ignoredia!

