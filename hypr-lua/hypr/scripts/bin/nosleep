#!/usr/bin/env bash

readonly RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
readonly PID_FILE="$RUNTIME_DIR/nosleep.pid"
readonly INHIBITOR_REASON="User requested idle inhibition"
readonly NOTIFICATION_TITLE="Idle inhibition"
readonly ENABLED_MESSAGE="Enabled"
readonly DISABLED_MESSAGE="Disabled"
readonly STOP_WAIT_SECONDS=1
readonly STOP_POLL_INTERVAL=0.05

INHIBITOR_PID=
FOREGROUND_CLEANED=0

is_running() {
    local pid

    [[ -r "$PID_FILE" ]] || return 1
    read -r pid < "$PID_FILE"
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    [[ "$(ps -o comm= -p "$pid" 2>/dev/null)" == "systemd-inhibit" ]]
}

clear_stale_state() {
    if ! is_running && [[ -e "$PID_FILE" ]]; then
        rm -f "$PID_FILE" || {
            printf 'nosleep: failed to remove stale state file: %s\n' "$PID_FILE" >&2
            return 1
        }
    fi
}

wait_for_exit() {
    local deadline=$((SECONDS + STOP_WAIT_SECONDS))
    while is_running && ((SECONDS < deadline)); do
        sleep "$STOP_POLL_INTERVAL"
    done
}

send_notification() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send --app-name=zzz "$NOTIFICATION_TITLE" "$1" ||
        printf 'nosleep: failed to send notification\n' >&2
}

format_duration() {
    local total_minutes=$(($1 / 60))
    local hours=$((total_minutes / 60))
    local minutes=$((total_minutes % 60))

    if ((hours > 0)); then
        printf '%dh %dm' "$hours" "$minutes"
    else
        printf '%dm' "$minutes"
    fi
}

parse_duration() {
    local value unit

    if [[ "$1" =~ ^([1-9][0-9]*)(m|h)$ ]]; then
        value=${BASH_REMATCH[1]}
        unit=${BASH_REMATCH[2]}
    else
        printf 'nosleep: duration must be a positive number followed by m or h\n' >&2
        return 1
    fi

    if [[ "$unit" == m ]]; then
        printf '%s\n' "$((value * 60))"
    else
        printf '%s\n' "$((value * 3600))"
    fi
}

parse_until() {
    local time="$1"
    local hour minute suffix target now

    if [[ "$time" =~ ^([0-9]{1,2}):([0-9]{2})(am|pm)?$ ]]; then
        hour=${BASH_REMATCH[1]}
        minute=${BASH_REMATCH[2]}
        suffix=${BASH_REMATCH[3]}
    else
        printf 'nosleep: time must use HH:MM, HH:MMam, or HH:MMpm\n' >&2
        return 1
    fi

    if ((minute > 59)); then
        printf 'nosleep: minutes must be between 00 and 59\n' >&2
        return 1
    fi
    if [[ -n "$suffix" ]] && ((hour < 1 || hour > 12)); then
        printf 'nosleep: 12-hour time must use an hour between 1 and 12\n' >&2
        return 1
    fi
    if [[ -z "$suffix" ]] && ((hour > 23)); then
        printf 'nosleep: 24-hour time must use an hour between 00 and 23\n' >&2
        return 1
    fi

    target=$(date -d "today $time" +%s 2>/dev/null) || {
        printf 'nosleep: could not parse time: %s\n' "$time" >&2
        return 1
    }
    now=$(date +%s)
    if ((target <= now)); then
        target=$(date -d "tomorrow $time" +%s 2>/dev/null) || {
            printf 'nosleep: could not calculate next occurrence: %s\n' "$time" >&2
            return 1
        }
    fi
    printf '%s\n' "$target"
}

prepare_start() {
    if is_running; then
        printf 'nosleep: already enabled\n' >&2
        printf 'Use "nosleep stop" to disable it.\n' >&2
        return 1
    fi
    clear_stale_state || return 1
    command -v systemd-inhibit >/dev/null 2>&1 || {
        printf 'nosleep: systemd-inhibit not found\n' >&2
        return 1
    }
}

start_inhibitor() {
    local duration="$1"
    local deadline="$2"
    local label="$3"
    local now sleep_seconds

    if [[ -n "$deadline" ]]; then
        now=$(date +%s)
        sleep_seconds=$((deadline - now))
        ((sleep_seconds > 0)) || {
            printf 'nosleep: deadline has already passed\n' >&2
            return 1
        }
        systemd-inhibit --what=idle --why="$INHIBITOR_REASON" --mode=block sleep "$sleep_seconds" &
    elif [[ -n "$duration" ]]; then
        systemd-inhibit --what=idle --why="$INHIBITOR_REASON" --mode=block sleep "$duration" &
    else
        systemd-inhibit --what=idle --why="$INHIBITOR_REASON" --mode=block sleep infinity &
    fi
    INHIBITOR_PID=$!
    printf '%s\n%s\n' "$INHIBITOR_PID" "$deadline" > "$PID_FILE" || {
        kill "$INHIBITOR_PID"
        printf 'nosleep: failed to write state file: %s\n' "$PID_FILE" >&2
        return 1
    }
    if ! is_running; then
        rm -f "$PID_FILE"
        printf 'nosleep: inhibitor failed to start\n' >&2
        return 1
    fi
    send_notification "$ENABLED_MESSAGE${label:+ $label}"
}

cleanup_foreground() {
    ((FOREGROUND_CLEANED)) && return 0
    FOREGROUND_CLEANED=1
    kill "$INHIBITOR_PID" 2>/dev/null || true
    rm -f "$PID_FILE" || printf 'nosleep: failed to remove state file: %s\n' "$PID_FILE" >&2
    send_notification "$DISABLED_MESSAGE"
}

show_status() {
    local -a state
    local pid deadline now remaining

    clear_stale_state || return 1
    if ! is_running; then
        printf 'off\n'
        return 0
    fi

    mapfile -t state < "$PID_FILE"
    pid=${state[0]}
    deadline=${state[1]}
    if [[ "$deadline" =~ ^[0-9]+$ && "$deadline" -gt 0 ]]; then
        now=$(date +%s)
        remaining=$((deadline - now))
        if ((remaining <= 0)); then
            printf 'off\n'
        else
            printf 'on — %s remaining\n' "$(format_duration "$remaining")"
        fi
    else
        printf 'on — indefinite\n'
    fi
}

start() {
    local duration="$1"
    local deadline="$2"
    local label="$3"

    prepare_start || return 1
    start_inhibitor "$duration" "$deadline" "$label" || return 1
    printf 'nosleep: enabled%s\n' "${label:+ $label}"
}

run_foreground() {
    local duration="$1"
    local deadline="$2"
    local label="$3"

    prepare_start || return 1
    start_inhibitor "$duration" "$deadline" "$label" || return 1
    printf 'nosleep: enabled%s (press Ctrl+C to disable)\n' "${label:+ $label}"
    trap cleanup_foreground EXIT INT TERM HUP
    wait "$INHIBITOR_PID"
}

stop() {
    local pid

    if ! is_running; then
        clear_stale_state || return 1
        printf 'nosleep: not running\n' >&2
        printf 'Use "nosleep on" to enable it.\n' >&2
        return 1
    fi

    read -r pid < "$PID_FILE"
    kill "$pid"
    wait_for_exit
    if is_running; then
        kill -KILL "$pid"
        wait_for_exit
    fi
    rm -f "$PID_FILE" || {
        printf 'nosleep: failed to remove state file: %s\n' "$PID_FILE" >&2
        return 1
    }
    send_notification "$DISABLED_MESSAGE"
}

kill_inhibitor() {
    local pid

    if ! is_running; then
        clear_stale_state || return 1
        printf 'nosleep: not running\n' >&2
        printf 'Use "nosleep on" to enable it.\n' >&2
        return 1
    fi

    read -r pid < "$PID_FILE"
    kill -KILL "$pid"
    wait_for_exit
    rm -f "$PID_FILE" || {
        printf 'nosleep: failed to remove state file: %s\n' "$PID_FILE" >&2
        return 1
    }
    send_notification "$DISABLED_MESSAGE"
}

action=foreground
duration=
deadline=
label=

while (($# > 0)); do
    case "$1" in
        on) action=background ;;
        status|off|stop|kill) action="$1" ;;
        --for)
            (($# >= 2)) || { printf 'nosleep: --for needs a duration\n' >&2; exit 2; }
            [[ -z "$duration" && -z "$deadline" ]] || { printf 'nosleep: use only one of --for or --until\n' >&2; exit 2; }
            duration=$(parse_duration "$2") || exit 2
            deadline=$(( $(date +%s) + duration ))
            label="for $(format_duration "$duration")"
            shift
            ;;
        --until)
            (($# >= 2)) || { printf 'nosleep: --until needs a time\n' >&2; exit 2; }
            [[ -z "$duration" && -z "$deadline" ]] || { printf 'nosleep: use only one of --for or --until\n' >&2; exit 2; }
            deadline=$(parse_until "$2") || exit 2
            label="until $2"
            shift
            ;;
        --help|-h)
            printf 'Usage: nosleep [on] [--for DURATION|--until TIME]\n'
            printf '       nosleep status|off|stop|kill\n'
            exit 0
            ;;
        *)
            printf 'nosleep: unknown argument: %s\n' "$1" >&2
            exit 2
            ;;
    esac
    shift
done

case "$action" in
    foreground) run_foreground "$duration" "$deadline" "$label" ;;
    background) start "$duration" "$deadline" "$label" ;;
    status) show_status ;;
    off|stop) stop ;;
    kill) kill_inhibitor ;;
esac
