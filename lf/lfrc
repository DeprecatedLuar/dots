# interpreter for shell commands (needs to be POSIX compatible)
set shell bash

set shellopts '-eu'
set ifs "\n"
set scrolloff 10
set watch true
set previewer ~/.config/lf/scripts/previewer
set cleaner ~/.config/lf/scripts/cleaner
set info size
set dircounts
set timefmt "2006-01-02 15:04"

source ~/.config/lf/cmds.lf
source ~/.config/lf/keybinds.lf
