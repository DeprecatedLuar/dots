#!/usr/bin/env bash

set -euo pipefail

readonly SELF_HEAL="${HOME:?}/.config/hypr/.framework/self-heal.sh"

[[ -x "$SELF_HEAL" ]] || {
    printf 'hypreload: self-heal script is missing or not executable: %s\n' "$SELF_HEAL" >&2
    exit 1
}

command -v hyprctl >/dev/null 2>&1 || {
    printf 'hypreload: hyprctl not found on PATH\n' >&2
    exit 1
}

"$SELF_HEAL"
exec hyprctl reload
