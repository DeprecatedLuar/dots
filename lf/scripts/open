#!/usr/bin/env bash
# Opens files: text in $EDITOR, images and binaries detached via $OPENER.
set -euo pipefail

DEFAULT_OPENER="xdg-open"
BINARY_ENCODING="binary"

opener="${OPENER:-$DEFAULT_OPENER}"

if [ "$#" -eq 0 ]; then
    echo "usage: open FILE..." >&2
    exit 1
fi

open_detached() {
    for f in "$@"; do setsid "$opener" "$f" >/dev/null 2>&1 & done
}

case "$(file -Lb --mime-type -- "$1")" in
    image/*) open_detached "$@"; exit 0 ;;
esac

# Encoding rather than mime type: libmagic misreports some text (e.g. Lua as application/javascript)
if [ "$(file -Lb --mime-encoding -- "$1")" != "$BINARY_ENCODING" ]; then
    exec "${EDITOR:?EDITOR is not set}" "$@"
fi

open_detached "$@"
